{
  "name": "pg-vue-tailwindcss",
  "version": "1.0.0",
  "description": "Aplikasi Desktop POS Vue Electron",
  "author": "M Hasanuddin",
  "type": "module",
  "main": "dist-electron/main.js",
  "homepage": "https://pg-vue-tailwindcss.netlify.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/pinegrow/pg-vue-tailwindcss.git"
  },
  "scripts": {
    "dev": "vite",
    "now": "npm run build && npm run preview",
    "lighthouse": "npx unlighthouse --no-cache --site https://pg-vue-tailwindcss.netlify.app",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "app:build": "npm run build && electron-builder",
    "type-check": "vue-tsc --noEmit",
    "lint": "npm run lint:fix && npm run format",
    "lint:fix": "eslint --fix ./",
    "format": "prettier --write \"**/*.{html,vue,svelte,astro,js,jsx,cjs,mjs,ts,tsx,cts,mts,css,md,mdx,json}\" !public --ignore-path .gitignore"
  },
  "build": {
    "appId": "com.pinegrow.pgvuetailwindcss",
    "productName": "PG Vue Application",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "**/node_modules/serialport/**/*"
    ]
  },
  "dependencies": {
    "@point-of-sale/receipt-printer-encoder": "^3.0.3",
    "@revolist/revo-dropdown": "^3.0.10",
    "@revolist/revogrid-column-date": "^2.0.25",
    "@revolist/revogrid-column-numeral": "^2.0.11",
    "@revolist/revogrid-column-select": "^3.2.0",
    "@revolist/vue3-datagrid": "^4.20.2",
    "@unhead/schema": "^1.11.15",
    "@unhead/schema-org": "^1.11.15",
    "@unhead/vue": "^1.11.15",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^12.4.0",
    "axios": "^1.17.0",
    "exceljs": "^4.4.0",
    "flowbite": "^4.0.1",
    "flowbite-vue": "^0.2.2",
    "jsbarcode": "^3.12.3",
    "lite-youtube-embed": "^0.3.3",
    "mathjs": "^15.2.0",
    "nodemailer": "^9.0.5",
    "ofetch": "^1.4.1",
    "pinia": "^2.3.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "puppeteer": "^25.7.0",
    "serialport": "^13.0.0",
    "socket.io-client": "^4.8.3",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@iconify-json/mdi-light": "^1.2.2",
    "@iconify/json": "^2.2.294",
    "@iconify/vue": "^5.0.1",
    "@nuxt/eslint-config": "^0.7.5",
    "@pinegrow/tailwindcss-plugin": "^3.0.35",
    "@pinegrow/vite-plugin": "^3.0.69",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tsconfig/node22": "^22.0.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it-link-attributes": "^3.0.5",
    "@types/node": "^22.20.1",
    "@unocss/preset-icons": "^65.4.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "beasties": "^0.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-shiki": "^0.9.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "unocss": "^65.4.0",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "unplugin-vue-markdown": "^28.0.0",
    "unplugin-vue-router": "^0.10.9",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-git-revision-info": "^1.1.0",
    "vite-plugin-vue-devtools": "8.0.5",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vue-tsc": "^2.2.0"
  },
  "web-types": "web-types.json"
}
